// ==========================================================
// DILIGÊNCIA 360 — Esquema Relacional com Relatórios e Dossiês PDF
// Compliance SUAPE — PostgreSQL (Fase 7)
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  firebaseUid  String?   @unique @map("firebase_uid")
  name         String
  email        String    @unique
  passwordHash String?   @map("password_hash")
  role         String    @default("analyst") // admin, analyst, reviewer, viewer
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  createdDiligences  Diligence[]       @relation("DiligenceCreatedBy")
  reviewedDiligences Diligence[]       @relation("DiligenceReviewedBy")
  generatedReports   DiligenceReport[]
  reviewActions      ReviewAction[]
  auditEvents        AuditEvent[]

  @@map("users")
}

model Company {
  id            String   @id @default(uuid())
  cnpj          String   @unique
  corporateName String   @map("corporate_name")
  tradeName     String?  @map("trade_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  diligences Diligence[]

  @@map("companies")
}

model Diligence {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  createdById         String?   @map("created_by_id")
  reviewedById        String?   @map("reviewed_by_id")
  status              String    @default("in_progress") // in_progress, pending_review, in_review, returned_for_adjustments, completed, cancelled
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")
  preliminaryScore    Int       @default(0) @map("preliminary_score")
  preliminaryLevel    String    @default("Atenção Baixa") @map("preliminary_level")
  recommendation      String    @map("recommendation")
  summary             String?   @map("summary")
  returnJustification String?   @map("return_justification")
  companySnapshot     Json      @map("company_snapshot")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  User?   @relation("DiligenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?   @relation("DiligenceReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  shareholders   DiligenceShareholder[]
  pepMatches     PepMatch[]
  sanctions      Sanction[]
  adverseMedia   AdverseMediaResult[]
  discoveries    ProcessDiscovery[]
  evidences      Evidence[]
  riskAssessment RiskAssessment?
  reviewActions  ReviewAction[]
  auditEvents    AuditEvent[]
  reports        DiligenceReport[]
  egosRun        EgosRun?

  @@map("diligences")
}

model DiligenceReport {
  id            String   @id @default(uuid())
  diligenceId   String   @map("diligence_id")
  version       Int      @default(1)
  reportNumber  String   @map("report_number") // Ex: DIL-2026-000031
  fileName      String   @map("file_name")
  mimeType      String   @default("application/pdf") @map("mime_type")
  hashAlgorithm String   @default("SHA-256") @map("hash_algorithm")
  hashValue     String   @map("hash_value")
  generatedById String?  @map("generated_by_id")
  generatedAt   DateTime @default(now()) @map("generated_at")

  diligence   Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  generatedBy User?     @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@map("diligence_reports")
}

model DiligenceShareholder {
  id            String  @id @default(uuid())
  diligenceId   String  @map("diligence_id")
  name          String
  qualification String?
  entryDate     String? @map("entry_date")
  cpfCnpj       String? @map("cpf_cnpj")
  rawData       Json?   @map("raw_data")

  diligence  Diligence  @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  pepMatches PepMatch[]

  @@map("diligence_shareholders")
}

model PepMatch {
  id            String  @id @default(uuid())
  diligenceId   String  @map("diligence_id")
  shareholderId String? @map("shareholder_id")
  nameSearched  String  @map("name_searched")
  matchedName   String? @map("matched_name")
  organization  String?
  role          String?
  startDate     String? @map("start_date")
  endDate       String? @map("end_date")
  status        String  @default("possible_match")
  reviewStatus  String  @default("pending") @map("review_status") // pending, confirmed, discarded
  rawData       Json?   @map("raw_data")

  diligence   Diligence             @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  shareholder DiligenceShareholder? @relation(fields: [shareholderId], references: [id], onDelete: SetNull)

  @@map("pep_matches")
}

model Sanction {
  id              String  @id @default(uuid())
  diligenceId     String  @map("diligence_id")
  source          String // CEIS, CNEP
  sanctionType    String? @map("sanction_type")
  sanctioningBody String? @map("sanctioning_body")
  state           String?
  startDate       String? @map("start_date")
  endDate         String? @map("end_date")
  active          Boolean @default(true)
  scope           String?
  processNumber   String? @map("process_number")
  legalBasis      String? @map("legal_basis")
  rawData         Json?   @map("raw_data")

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)

  @@map("sanctions")
}

model AdverseMediaResult {
  id            String   @id @default(uuid())
  diligenceId   String   @map("diligence_id")
  title         String
  url           String
  domain        String
  publishedAt   String?  @map("published_at")
  snippet       String?
  matchStrength String   @default("low") @map("match_strength") // high, medium, low
  matchedTerms  Json?    @map("matched_terms")
  categories    Json?
  status        String   @default("candidate") // candidate, validated, discarded
  searchedAt    DateTime @default(now()) @map("searched_at")
  rawData       Json?    @map("raw_data")

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)

  @@map("adverse_media_results")
}

model JudicialProcess {
  id                String   @id @default(uuid())
  processNumber     String   @unique @map("process_number")
  formattedNumber   String?  @map("formatted_number")
  tribunal          String
  degree            String?  @default("G1")
  classCode         Int?     @map("class_code")
  className         String?  @map("class_name")
  filingDate        String?  @map("filing_date")
  secrecyLevel      Int?     @default(0) @map("secrecy_level")
  courtName         String?  @map("court_name")
  courtCity         String?  @map("court_city")
  systemName        String?  @default("PJe") @map("system_name")
  lastDatajudUpdate String?  @map("last_datajud_update")
  rawData           Json?    @map("raw_data")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  discoveries ProcessDiscovery[]

  @@map("judicial_processes")
}

model ProcessDiscovery {
  id                     String   @id @default(uuid())
  diligenceId            String   @map("diligence_id")
  judicialProcessId      String?  @map("judicial_process_id")
  processNumber          String   @map("process_number")
  formattedProcessNumber String?  @map("formatted_process_number")
  tribunal               String
  sourceType             String   @map("source_type") // adverse_media, djen, certidao, manual, document
  sourceName             String   @map("source_name")
  sourceUrl              String?  @map("source_url")
  excerpt                String?
  discoveredAt           DateTime @default(now()) @map("discovered_at")
  status                 String   @default("candidate") // candidate, validated, enriched, discarded

  diligence       Diligence        @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  judicialProcess JudicialProcess? @relation(fields: [judicialProcessId], references: [id], onDelete: SetNull)

  @@map("process_discoveries")
}

model Evidence {
  id           String   @id @default(uuid())
  diligenceId  String   @map("diligence_id")
  source       String // BrasilAPI, CGU / CEIS, CGU / CNEP, CGU / PEP, Brave Search, DataJud
  sourceType   String   @map("source_type")
  query        String
  resultStatus String   @map("result_status")
  consultedAt  DateTime @default(now()) @map("consulted_at")
  url          String?
  metadata     Json?

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)

  @@map("evidences")
}

model RiskAssessment {
  id                 String   @id @default(uuid())
  diligenceId        String   @unique @map("diligence_id")
  score              Int
  level              String
  decision           String
  decisionDesc       String?  @map("decision_desc")
  calculatedAt       DateTime @default(now()) @map("calculated_at")
  methodologyVersion String   @default("v1.0") @map("methodology_version")
  breakdown          Json

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)

  @@map("risk_assessments")
}

model ReviewAction {
  id             String   @id @default(uuid())
  diligenceId    String   @map("diligence_id")
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type") // pep_match, adverse_media, process_discovery, general, workflow
  entityId       String   @map("entity_id")
  action         String // validate, discard, return, approve, submit
  previousStatus String?  @map("previous_status")
  newStatus      String   @map("new_status")
  justification  String?
  reviewedBy     String   @default("Auditor Compliance SUAPE") @map("reviewed_by")
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("review_actions")
}

model AuditEvent {
  id          String   @id @default(uuid())
  diligenceId String   @map("diligence_id")
  userId      String?  @map("user_id")
  eventType   String   @default("info") @map("event_type") // info, warning, error, review, workflow, auth, report
  message     String
  metadata    Json?
  actor       String   @default("Sistema / Diligência 360")
  createdAt   DateTime @default(now()) @map("created_at")

  diligence Diligence @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_events")
}

// ==========================================================
// EGOS — Entity Graph & Open-source Intelligence System
// Modelo canônico aditivo, inspirado nos conceitos do FollowTheMoney
// ==========================================================

model CanonicalEntity {
  id             String   @id @default(uuid())
  entityType     String   @map("entity_type")
  canonicalKey   String   @unique @map("canonical_key")
  name           String
  normalizedName String   @map("normalized_name")
  properties     Json
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @updatedAt @map("last_seen_at")

  identifiers      EgosEntityIdentifier[]
  aliases          EgosEntityAlias[]
  outgoing         CanonicalRelationship[] @relation("EgosRelationshipSource")
  incoming         CanonicalRelationship[] @relation("EgosRelationshipTarget")
  runMemberships   EgosRunEntity[]
  rootRuns         EgosRun[]               @relation("EgosRunRoot")
  evidences        EgosEvidence[]
  findings         EgosFinding[]
  sourceMatches    EgosResolution[]        @relation("EgosResolutionSource")
  candidateMatches EgosResolution[]        @relation("EgosResolutionCandidate")

  @@index([entityType])
  @@index([normalizedName])
  @@map("egos_entities")
}

model EgosEntityIdentifier {
  id             String   @id @default(uuid())
  entityId       String   @map("entity_id")
  identifierType String   @map("identifier_type")
  value          String
  provider       String
  confidence     Int      @default(100)
  createdAt      DateTime @default(now()) @map("created_at")

  entity CanonicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, identifierType, value])
  @@index([identifierType, value])
  @@map("egos_entity_identifiers")
}

model EgosEntityAlias {
  id         String   @id @default(uuid())
  entityId   String   @map("entity_id")
  value      String
  normalized String
  aliasType  String   @default("name") @map("alias_type")
  provider   String
  createdAt  DateTime @default(now()) @map("created_at")

  entity CanonicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, normalized, aliasType])
  @@index([normalized])
  @@map("egos_entity_aliases")
}

model CanonicalRelationship {
  id               String   @id @default(uuid())
  canonicalKey     String   @unique @map("canonical_key")
  sourceEntityId   String   @map("source_entity_id")
  targetEntityId   String   @map("target_entity_id")
  relationshipType String   @map("relationship_type")
  label            String
  properties       Json
  firstSeenAt      DateTime @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime @updatedAt @map("last_seen_at")

  sourceEntity   CanonicalEntity       @relation("EgosRelationshipSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity   CanonicalEntity       @relation("EgosRelationshipTarget", fields: [targetEntityId], references: [id], onDelete: Cascade)
  runMemberships EgosRunRelationship[]
  evidences      EgosEvidence[]
  findings       EgosFinding[]

  @@index([sourceEntityId, relationshipType])
  @@index([targetEntityId, relationshipType])
  @@map("egos_relationships")
}

model EgosRun {
  id           String    @id @default(uuid())
  diligenceId  String    @unique @map("diligence_id")
  rootEntityId String?   @map("root_entity_id")
  status       String    @default("completed")
  maxDepth     Int       @default(2) @map("max_depth")
  metrics      Json
  summary      Json
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")

  diligence     Diligence             @relation(fields: [diligenceId], references: [id], onDelete: Cascade)
  rootEntity    CanonicalEntity?      @relation("EgosRunRoot", fields: [rootEntityId], references: [id], onDelete: SetNull)
  entities      EgosRunEntity[]
  relationships EgosRunRelationship[]
  evidences     EgosEvidence[]
  coverage      EgosCoverage[]
  findings      EgosFinding[]
  resolutions   EgosResolution[]

  @@index([status, completedAt])
  @@map("egos_runs")
}

model EgosRunEntity {
  id         String   @id @default(uuid())
  runId      String   @map("run_id")
  entityId   String   @map("entity_id")
  depth      Int      @default(0)
  role       String   @default("related")
  confidence Int      @default(100)
  createdAt  DateTime @default(now()) @map("created_at")

  run    EgosRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity CanonicalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([runId, entityId])
  @@index([runId, depth])
  @@map("egos_run_entities")
}

model EgosRunRelationship {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  relationshipId String   @map("relationship_id")
  status         String   @default("confirmed")
  confidence     Int      @default(100)
  createdAt      DateTime @default(now()) @map("created_at")

  run          EgosRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  relationship CanonicalRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)

  @@unique([runId, relationshipId])
  @@map("egos_run_relationships")
}

model EgosEvidence {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  entityId       String?  @map("entity_id")
  relationshipId String?  @map("relationship_id")
  provider       String
  sourceName     String   @map("source_name")
  sourceUrl      String?  @map("source_url")
  query          String?
  identifier     String?
  excerpt        String?
  confidence     Int?
  rawReference   Json?    @map("raw_reference")
  retrievedAt    DateTime @default(now()) @map("retrieved_at")

  run          EgosRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity       CanonicalEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relationship CanonicalRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@index([runId, provider])
  @@index([entityId])
  @@index([relationshipId])
  @@map("egos_evidences")
}

model EgosCoverage {
  id          String    @id @default(uuid())
  runId       String    @map("run_id")
  axis        String
  provider    String
  status      String
  message     String
  resultCount Int       @default(0) @map("result_count")
  consultedAt DateTime? @map("consulted_at")
  validUntil  DateTime? @map("valid_until")

  run EgosRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, axis, provider])
  @@index([runId, status])
  @@map("egos_coverage")
}

model EgosFinding {
  id             String   @id @default(uuid())
  runId          String   @map("run_id")
  entityId       String?  @map("entity_id")
  relationshipId String?  @map("relationship_id")
  axis           String
  status         String
  severity       String
  title          String
  explanation    String
  confidence     Int?
  reviewStatus   String   @default("pending") @map("review_status")
  createdAt      DateTime @default(now()) @map("created_at")

  run          EgosRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  entity       CanonicalEntity?       @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relationship CanonicalRelationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)

  @@index([runId, status, severity])
  @@map("egos_findings")
}

model EgosResolution {
  id                String   @id @default(uuid())
  runId             String   @map("run_id")
  sourceEntityId    String   @map("source_entity_id")
  candidateEntityId String   @map("candidate_entity_id")
  score             Int
  status            String
  signals           Json
  reviewStatus      String   @default("pending") @map("review_status")
  createdAt         DateTime @default(now()) @map("created_at")

  run             EgosRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceEntity    CanonicalEntity @relation("EgosResolutionSource", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  candidateEntity CanonicalEntity @relation("EgosResolutionCandidate", fields: [candidateEntityId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceEntityId, candidateEntityId])
  @@index([runId, score])
  @@map("egos_resolutions")
}

model InternalDataset {
  id                String   @id @default(uuid())
  organization      String
  sourceName        String   @map("source_name")
  fileHash          String   @unique @map("file_hash")
  referencePeriod   String?  @map("reference_period")
  importedAt        DateTime @default(now()) @map("imported_at")
  recordCount       Int      @default(0) @map("record_count")
  uniquePersonCount Int      @default(0) @map("unique_person_count")
  status            String   @default("active")
  metadata          Json     @default("{}")

  affiliations InternalAffiliation[]

  @@index([organization, referencePeriod])
  @@map("internal_datasets")
}

model InternalPerson {
  id             String   @id @default(uuid())
  employeeKey    String   @unique @map("employee_key")
  employeeId     String?  @map("employee_id")
  name           String
  normalizedName String   @map("normalized_name")
  maskedCpf      String?  @map("masked_cpf")
  organization   String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  affiliations InternalAffiliation[]

  @@index([normalizedName])
  @@index([organization])
  @@map("internal_people")
}

model InternalAffiliation {
  id              String   @id @default(uuid())
  personId        String   @map("person_id")
  datasetId       String   @map("dataset_id")
  employmentType  String?  @map("employment_type")
  organization    String
  referencePeriod String?  @map("reference_period")
  sourceSheet     String   @map("source_sheet")
  sourceRow       Int?     @map("source_row")
  current         Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  person  InternalPerson  @relation(fields: [personId], references: [id], onDelete: Cascade)
  dataset InternalDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([personId, datasetId, employmentType, sourceSheet])
  @@index([datasetId])
  @@index([organization, current])
  @@map("internal_affiliations")
}
