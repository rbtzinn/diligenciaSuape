# ============================================
# Diligência 360 — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
#
# DATABASE_URL: String de conexão com o banco de dados PostgreSQL
# Exemplo: postgresql://postgres:senha@localhost:5432/diligencia360?schema=public
#
# CGU_API_KEY: Chave da API do Portal da Transparência (CGU)
# Cadastro gratuito: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
#
# BRAVE_SEARCH_API_KEY: Chave da API do Brave Search (Mídia Adversa)
# Cadastro gratuito: https://brave.com/search/api/
#
# ADVERSE_MEDIA_MAX_QUERIES: Limite de buscas web por diligência (padrão: 4)
#
# PORT: Porta do servidor (padrão: 3000)
# ============================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diligencia360?schema=public
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VITE_FIREBASE_API_KEY=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=Administrador SUAPE
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CGU_API_KEY=
BRAVE_SEARCH_API_KEY=
DATAJUD_API_KEY=
ADVERSE_MEDIA_MAX_QUERIES=4
PORT=3000
