# ==========================================================
# DILIGÊNCIA 360 — Ambiente local (Firebase + Google Sheets)
# ==========================================================

# Backend usado pelo frontend. Vazio usa o mesmo host no desenvolvimento.
VITE_API_BASE_URL=

# Firebase Web SDK — valores públicos do aplicativo Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK — conta de serviço usada para validar tokens.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Histórico permanente. A mesma conta de serviço do Firebase pode ser usada.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Opcionais: só preencha se a planilha usar outra conta de serviço.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Integrações oficiais e pesquisa.
CGU_API_KEY=
BRAVE_SEARCH_API_KEY=
# Ative somente se o contrato do plano autorizar armazenar resultados em dossiês/PDFs.
BRAVE_SEARCH_ALLOW_PERSISTENCE=false
DATAJUD_API_KEY=
# Canal web gratuito. SearXNG sobe junto no docker compose; sem ele, resta o DuckDuckGo Lite.
SEARXNG_BASE_URL=http://localhost:8888
SEARXNG_LANGUAGE=pt-BR
SEARXNG_ENGINES=
SEARXNG_SECRET=troque-esta-chave
DUCKDUCKGO_SEARCH_ENABLED=true
DUCKDUCKGO_REGION=br-pt
ADVERSE_MEDIA_MAX_QUERIES=9
ADVERSE_MEDIA_MAX_PERSON_SUBJECTS=20
ADVERSE_MEDIA_MAX_PERSON_QUERIES=160
ADVERSE_MEDIA_RESULTS_PER_QUERY=25
ADVERSE_MEDIA_CONCURRENCY=6
ADVERSE_MEDIA_DEADLINE_MS=50000
ADVERSE_MEDIA_QUERY_TIMEOUT_MS=9000
# Expansão de vínculos societários por nome e CPF mascarado (Minha Receita/RFB).
MINHA_RECEITA_GRAPH_BASE_URL=https://grafo.minhareceita.org
# Rastreio nominal de sócios pessoa física em CEIS/CNEP.
# O QSA público não traz CPF completo, então a busca é por nome.
PERSON_SANCTIONS_MAX_PEOPLE=20
PERSON_SANCTIONS_CONCURRENCY=3
PERSON_NETWORK_MAX_PEOPLE=10
PERSON_NETWORK_MAX_COMPANIES=20
PERSON_NETWORK_CONCURRENCY=3

PORT=3000
FRONTEND_PORT=8080

# Diários oficiais (Querido Diário) — busca nominal de empresa e pessoas físicas.
QUERIDO_DIARIO_API_URL=https://api.queridodiario.org.br/gazettes
GAZETTE_RESULTS_PER_SUBJECT=25
GAZETTE_MAX_PEOPLE=20
GAZETTE_CONCURRENCY=3
# Domínios oficiais varridos pelo canal web (separados por vírgula).
ADVERSE_MEDIA_INSTITUTIONAL_SITES=portaldatransparencia.gov.br,tcu.gov.br,tce.pe.gov.br,tse.jus.br,pncp.gov.br,cnj.jus.br,mpf.mp.br,mppe.mp.br,in.gov.br,diariooficial.pe.gov.br
